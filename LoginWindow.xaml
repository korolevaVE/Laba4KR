<Window x:Class="ShopApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Авторизация" Height="300" Width="380" Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <StackPanel Width="280" VerticalAlignment="Center">
            <TextBlock Text="Авторизация" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <TextBlock Text="Логин"/>
            <TextBox x:Name="LoginBox" Height="26" Margin="0,2,0,10"/>

            <TextBlock Text="Пароль"/>
            <PasswordBox x:Name="PasswordBox" Height="26" Margin="0,2,0,16"/>

            <Button Content="Войти" Height="30" IsDefault="True" Click="Login_Click"/>
        </StackPanel>
    </Grid>
</Window>
