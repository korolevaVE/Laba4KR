<Window x:Class="ShopApp.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Товар" Height="480" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="IdLabel" Text="ID товара:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="IdBox" IsReadOnly="True"
                     Margin="0,4" Height="26" VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Наименование товара:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="NameBox" IsEditable="True"
                      DisplayMemberPath="Name" Margin="0,4" Height="26"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Категория товара:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CategoryBox"
                      DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,4" Height="26"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Описание товара:" VerticalAlignment="Top" Margin="0,6,0,0"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="DescriptionBox"
                     TextWrapping="Wrap" AcceptsReturn="True" Height="80"
                     VerticalScrollBarVisibility="Auto" Margin="0,4"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Производитель:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="ManufacturerBox"
                      DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,4" Height="26"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Поставщик:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="5" Grid.Column="1" x:Name="SupplierBox"
                      DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,4" Height="26"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Цена:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="6" Grid.Column="1" x:Name="PriceBox" Margin="0,4" Height="26"
                     VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Количество на складе:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="7" Grid.Column="1" x:Name="CountBox" Margin="0,4" Height="26"
                     VerticalContentAlignment="Center"/>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Действующая скидка:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="8" Grid.Column="1" x:Name="DiscountBox" Margin="0,4" Height="26"
                     VerticalContentAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="DeleteButton" Content="Удалить" Width="100" Margin="0,0,8,0"
                    Click="Delete_Click"/>
            <Button Content="Сохранить" Width="100" Margin="0,0,8,0" IsDefault="True"
                    Click="Save_Click"/>
            <Button Content="Отмена" Width="100" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
