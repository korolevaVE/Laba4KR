<Window x:Class="ShopApp.ProductListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShopApp"
        mc:Ignorable="d"
        Title="Список товаров" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:DiscountToBackgroundConverter x:Key="DiscountToBackground"/>
        <local:DiscountToVisibilityConverter x:Key="DiscountToVisibility"/>
        <local:ProductImageConverter x:Key="ProductImage"/>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка: ФИО, роль, выход -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Добавить товар" Padding="10,2"
                    VerticalAlignment="Center" Click="AddProduct_Click"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock x:Name="FullNameText" FontWeight="Bold" TextAlignment="Right"/>
                    <TextBlock x:Name="RoleText" FontSize="11" Foreground="Gray" TextAlignment="Right"/>
                </StackPanel>
                <Button Content="Выход" Padding="10,2" Click="Logout_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Средства поиска -->
        <Expander Grid.Row="1" Header="Средства поиска" IsExpanded="True" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="8,4">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="SearchBox" Width="400" TextChanged="SearchBox_TextChanged"/>
            </StackPanel>
        </Expander>

        <!-- Список товаров -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Products}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black" BorderThickness="1" Margin="4"
                                Cursor="Hand" MouseLeftButtonUp="Card_Click"
                                Background="{Binding Discount, Converter={StaticResource DiscountToBackground}}">
                            <Grid Margin="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <!-- Фото -->
                                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1" Margin="4">
                                    <Grid>
                                        <TextBlock Text="Фото" Foreground="Gray"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding ImagePath, Converter={StaticResource ProductImage}}"
                                               Stretch="Uniform"/>
                                    </Grid>
                                </Border>

                                <!-- Данные товара -->
                                <StackPanel Grid.Column="1" Margin="6,0">
                                    <TextBlock FontWeight="Bold" FontSize="14">
                                        <Run Text="{Binding Category.Name}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding Name.Name}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Артикул: "/>
                                        <Run Text="{Binding Article}"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="Описание товара: "/>
                                        <Run Text="{Binding Description}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Производитель: "/>
                                        <Run Text="{Binding Manufacturer.Name}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Поставщик: "/>
                                        <Run Text="{Binding Supplier.Name}"/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Цена: " Margin="0,0,4,0"/>
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding Discount, Converter={StaticResource DiscountToVisibility}}">
                                            <TextBlock Text="{Binding Price, StringFormat={}{0:0.##}}"
                                                       TextDecorations="Strikethrough" Foreground="Red"
                                                       Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding FinalPrice, StringFormat={}{0:0.##}}"
                                                       Foreground="Red"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Price, StringFormat={}{0:0.##}}"
                                                   Visibility="{Binding Discount, Converter={StaticResource DiscountToVisibility}, ConverterParameter=Invert}"/>
                                    </StackPanel>
                                    <TextBlock>
                                        <Run Text="Единица измерения: "/>
                                        <Run Text="{Binding UnitName, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Количество на складе: "/>
                                        <Run Text="{Binding Count, StringFormat={}{0:0.#}}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Действующая скидка -->
                                <Border Grid.Column="2" BorderBrush="Black" BorderThickness="1" Margin="4">
                                    <TextBlock Text="{Binding Discount, StringFormat={}{0:0.#}}"
                                               FontSize="20" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
